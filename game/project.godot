; Engine configuration file.

config_version=5

[application]

config/name="광복 IF"
config/description="보드게임 「결사」 디지털판 (1인 + AI 동료)"
run/main_scene="res://scenes/main.tscn"
config/version="1.1.0"
run/max_fps=60
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"
config/windows_native_icon="res://assets/brand/icon.ico"
boot_splash/bg_color=Color(0.105882, 0.0901961, 0.0784314, 1)
boot_splash/image="res://assets/brand/splash.png"
boot_splash/fullsize=false

[autoload]

Prefs="*res://scripts/ui/prefs.gd"
Sfx="*res://scripts/ui/sfx.gd"
Music="*res://scripts/ui/music.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-VF.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

textures/canvas_textures/default_texture_filter=1
